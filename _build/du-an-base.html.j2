<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% block title %}{% endblock %}</title>
<meta name="description" content="{% block desc %}{% endblock %}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Công ty cổ phần gỗ HAVICO">
<meta property="og:title" content="{{ self.title() }}">
<meta property="og:description" content="{{ self.desc() }}">
<meta property="og:url" content="https://havicof.vn/{% block path %}{% endblock %}">
<meta property="og:image" content="https://havicof.vn{% block og %}/img/og-image.jpg{% endblock %}">
<meta name="theme-color" content="#07529D">
<link rel="canonical" href="https://havicof.vn/{{ self.path() }}">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/du-an.css?v=1">
<script async src="https://www.googletagmanager.com/gtag/js?id=G-J76Q0MK2Z8"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag("js", new Date());
  gtag("config", "G-J76Q0MK2Z8");
  document.addEventListener("click", function (e) {
    var a = e.target.closest && e.target.closest('a[href^="tel:"], a[href^="mailto:"]');
    if (a) gtag("event", "generate_lead", { method: a.protocol.slice(0, -1) });
  });
</script>
</head>
<body>
<header class="bar">
  <a class="bar-logo" href="/" aria-label="HAVICO – trang chủ"><img src="/img/logo-blue.svg" alt="HAVICO"></a>
  <nav><a href="/">Trang chủ</a><a href="/du-an/">Dự án</a><a class="bar-cta" href="/#lien-he">Liên hệ</a></nav>
</header>
<main>
{% block main %}{% endblock %}
  <section class="cta">
    <h2>Bạn có dự án tương tự?</h2>
    <p>HAVICO thiết kế, sản xuất và lắp đặt nội thất gỗ trọn gói tại nhà máy 14.000 m² ở Hải Phòng.</p>
    <div><a class="btn" href="mailto:sale01@havicof.com">Gửi yêu cầu báo giá</a><a class="btn ghost" href="tel:02256628888">0225.662.8888</a></div>
  </section>
</main>
<footer class="foot"><span>© Công ty cổ phần gỗ HAVICO · MST 0202229723</span><a href="/">havicof.vn</a></footer>
{% block script %}{% endblock %}
</body>
</html>
